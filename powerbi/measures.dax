// Generated by scripts/04_build_powerbi.py - same measures as the semantic model (_Measures table)

// [Volume] Number of shipment line items.
Line Items =
COUNTROWS ( fact_shipment )

// [Volume] Distinct advance shipment notices / delivery notes (physical consignments).
Shipments (ASN/DN) =
DISTINCTCOUNT ( fact_shipment[asn_dn_no] )

// [Volume]
Countries Served =
DISTINCTCOUNT ( fact_shipment[country_key] )

// [Volume]
Vendors Used =
DISTINCTCOUNT ( fact_shipment[vendor_key] )

// [Volume] Packs x units per pack.
Units Shipped =
SUM ( fact_shipment[units_total] )

// [Cost] Line item value, USD.
Commodity Value =
SUM ( fact_shipment[line_value_usd] )

// [Cost] Freight in USD, each consignment counted once (shared line items carry 0).
Freight Cost =
SUM ( fact_shipment[freight_usd_alloc] )

// [Cost]
Insurance Cost =
SUM ( fact_shipment[insurance_usd] )

// [Cost] Commodity value + allocated freight + insurance.
Landed Cost =
SUM ( fact_shipment[total_landed_cost_usd] )

// [Cost] Weight in kg, each consignment counted once.
Total Weight (kg) =
SUM ( fact_shipment[weight_kg_alloc] )

// [Cost] Freight / commodity value, only for line items whose freight is known.
Freight % of Value =
VAR _f = CALCULATE ( SUM ( fact_shipment[freight_usd_alloc] ), KEEPFILTERS ( fact_shipment[freight_status] IN { "Recorded", "Shared with ID" } ) )
VAR _v = CALCULATE ( SUM ( fact_shipment[line_value_usd] ), KEEPFILTERS ( fact_shipment[freight_status] IN { "Recorded", "Shared with ID" } ) )
RETURN
    DIVIDE ( _f, _v )

// [Cost] Weighted freight per kg over consignments with both freight and weight recorded.
Freight per kg =
VAR _f = CALCULATE ( SUM ( fact_shipment[freight_usd_alloc] ), KEEPFILTERS ( fact_shipment[freight_status] = "Recorded" ), KEEPFILTERS ( fact_shipment[weight_status] = "Recorded" ) )
VAR _w = CALCULATE ( SUM ( fact_shipment[weight_kg_alloc] ), KEEPFILTERS ( fact_shipment[freight_status] = "Recorded" ), KEEPFILTERS ( fact_shipment[weight_status] = "Recorded" ) )
RETURN
    DIVIDE ( _f, _w )

// [Cost] Share of line items with a usable freight value - read cost KPIs against this.
Freight Recorded % =
DIVIDE (
    CALCULATE ( [Line Items], KEEPFILTERS ( fact_shipment[freight_status] IN { "Recorded", "Shared with ID" } ) ),
    [Line Items]
)

// [Cost]
Avg Unit Price =
AVERAGE ( fact_shipment[unit_price_usd] )

// [Delivery]
Late Line Items =
CALCULATE ( [Line Items], KEEPFILTERS ( fact_shipment[is_late] = 1 ) )

// [Delivery] Share of line items delivered after the scheduled date.
Late Rate % =
DIVIDE ( [Late Line Items], [Line Items] )

// [Delivery]
On-Time Rate % =
IF ( NOT ISBLANK ( [Line Items] ), 1 - [Late Rate %] )

// [Delivery]
Avg Delay When Late (days) =
CALCULATE ( AVERAGE ( fact_shipment[delay_days] ), KEEPFILTERS ( fact_shipment[is_late] = 1 ) )

// [Delivery] PO sent to delivery; only Direct Drop orders have a PO date.
Median Lead Time (days) =
MEDIAN ( fact_shipment[lead_time_days] )

// [Delivery]
Severe Late (>30d) =
CALCULATE ( [Line Items], KEEPFILTERS ( fact_shipment[delivery_status] = "Late >30d" ) )

// [Delivery]
Late Rate % PY =
CALCULATE ( [Late Rate %], SAMEPERIODLASTYEAR ( dim_date[Date] ) )

// [Delivery] Change in late rate vs previous year, percentage points.
Late Rate Change (pp) =
IF ( NOT ISBLANK ( [Late Rate % PY] ), ( [Late Rate %] - [Late Rate % PY] ) * 100 )

// [Delivery] Late rate using the inactive relationship on scheduled date.
Late Rate by Scheduled Date % =
CALCULATE ( [Late Rate %], USERELATIONSHIP ( fact_shipment[scheduled_date], dim_date[Date] ) )

// [Delivery] Late rate shown only where there are at least 50 line items (hides noisy small groups).
Late Rate % (min 50) =
IF ( [Line Items] >= 50, [Late Rate %] )

// [Display] Red at 20% or more, amber at 12% or more, green otherwise.
Late Rate Colour =
SWITCH (
    TRUE (),
    ISBLANK ( [Late Rate %] ), BLANK (),
    [Late Rate %] >= 0.20, "#C0392B",
    [Late Rate %] >= 0.12, "#E8A33D",
    "#2E8B57"
)

// [Vendor]
Direct Drop Value =
CALCULATE ( [Commodity Value], KEEPFILTERS ( fact_shipment[fulfill_via] = "Direct Drop" ) )

// [Vendor] Share of value shipped from regional distribution centres.
RDC Share of Value % =
DIVIDE ( CALCULATE ( [Commodity Value], KEEPFILTERS ( fact_shipment[fulfill_via] = "From RDC" ) ), [Commodity Value] )

// [Vendor]
Vendor Value Share % =
DIVIDE ( [Commodity Value], CALCULATE ( [Commodity Value], ALL ( dim_vendor ) ) )

// [Vendor] Concentration of direct-drop spend in the five largest vendors.
Top 5 Direct Vendor Share % =
VAR _all = CALCULATE ( [Direct Drop Value], ALL ( dim_vendor ) )
VAR _top = SUMX ( TOPN ( 5, ALL ( dim_vendor[vendor_short] ), [Direct Drop Value] ), [Direct Drop Value] )
RETURN
    DIVIDE ( _top, _all )

// [Vendor] Pareto line: running share of direct-drop value, largest vendor first.
Cumulative Direct Vendor Share % =
VAR _cur = [Direct Drop Value]
VAR _tbl = FILTER ( ADDCOLUMNS ( ALLSELECTED ( dim_vendor[vendor_short] ), "@v", [Direct Drop Value] ), [@v] > 0 )
RETURN
    IF ( _cur > 0, DIVIDE ( SUMX ( FILTER ( _tbl, [@v] >= _cur ), [@v] ), SUMX ( _tbl, [@v] ) ) )

// [Vendor] 60% on-time rate + 40% cost efficiency (freight at 20% of value or more scores 0).
Vendor Score (0-100) =
VAR _rel = [On-Time Rate %]
VAR _fr = [Freight % of Value]
VAR _cost = IF ( ISBLANK ( _fr ), 0.5, 1 - MIN ( 1, _fr * 5 ) )
RETURN
    IF ( NOT ISBLANK ( _rel ), ROUND ( 100 * ( 0.6 * _rel + 0.4 * _cost ), 0 ) )
