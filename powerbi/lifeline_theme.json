{
  "name": "Lifeline Logistics",
  "dataColors": ["#1B7F8E", "#E8913A", "#12304A", "#7BBFC7", "#F2C462", "#5E7A99", "#3E9E6E", "#A0617F", "#9AA9B8", "#C65D3B"],
  "foreground": "#1F2A37",
  "foregroundNeutralSecondary": "#64748B",
  "foregroundNeutralTertiary": "#94A3B8",
  "background": "#FFFFFF",
  "backgroundLight": "#F5F8FA",
  "backgroundNeutral": "#DCE3EA",
  "tableAccent": "#1B7F8E",
  "good": "#2E8B57",
  "neutral": "#E8A33D",
  "bad": "#C0392B",
  "maximum": "#12304A",
  "center": "#7BBFC7",
  "minimum": "#EAF4F5",
  "textClasses": {
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#12304A" },
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#12304A" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#12304A" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#475569" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#DCE3EA" } }, "radius": 10, "width": 1 }],
        "dropShadow": [{ "show": true, "preset": "Bottom", "color": { "solid": { "color": "#12304A" } }, "transparency": 88 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#12304A" } }, "fontFamily": "Segoe UI Semibold", "fontSize": 11 }],
        "padding": [{ "top": 8, "bottom": 8, "left": 10, "right": 10 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#EEF2F6" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#E2E8EF" } }, "transparency": 0 }]
      }
    },
    "card": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#F4FAFB" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#C9E2E6" } }, "radius": 10, "width": 1 }],
        "labels": [{ "color": { "solid": { "color": "#12304A" } }, "fontFamily": "Segoe UI Semibold" }],
        "categoryLabels": [{ "show": true, "color": { "solid": { "color": "#1B7F8E" } }, "fontSize": 10, "fontFamily": "Segoe UI Semibold" }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "fontColor": { "solid": { "color": "#12304A" } }, "bold": true, "textSize": 9 }]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{ "backColor": { "solid": { "color": "#12304A" } }, "fontColor": { "solid": { "color": "#FFFFFF" } }, "bold": true }],
        "values": [{ "backColorPrimary": { "solid": { "color": "#FFFFFF" } }, "backColorSecondary": { "solid": { "color": "#F3F7F9" } }, "fontColorPrimary": { "solid": { "color": "#1F2A37" } }, "fontColorSecondary": { "solid": { "color": "#1F2A37" } } }]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [{ "backColor": { "solid": { "color": "#12304A" } }, "fontColor": { "solid": { "color": "#FFFFFF" } }, "bold": true }],
        "rowHeaders": [{ "fontColor": { "solid": { "color": "#12304A" } }, "bold": true }],
        "values": [{ "backColorPrimary": { "solid": { "color": "#FFFFFF" } }, "backColorSecondary": { "solid": { "color": "#F3F7F9" } } }]
      }
    }
  }
}
